{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabka-delivery-runtime-check",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sabka-delivery-runtime-check",
      "database_id": "756cc643-af58-42dd-aa62-708c09b5c853",
      "migrations_dir": "migrations/runtime"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
